# ==================== Telegram ====================
BOT_TOKEN=your_bot_token_here
ADMIN_IDS_STR=123456789,987654321
MAIN_GROUP_ID=-1001234567890

# ==================== Database ====================
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DEBUG=false

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
USE_REDIS_STORAGE=true

# ==================== Security ====================
SECRET_KEY=super_long_random_secret_key_at_least_64_chars_for_sessions_and_webhook
ADMIN_PASSWORD_HASH=$2b$12$...your_bcrypt_hash_here...

# ==================== Render / Webhook ====================
RENDER_URL=https://your-app.onrender.com

# ==================== Monitoring ====================
SENTRY_DSN=
ENVIRONMENT=production

# ==================== Business ====================
PLAN_AMOUNT=600000